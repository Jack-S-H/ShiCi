{
    "name": "拾词",
    "description": "一本极简且好用的词语笔记本",
    "version": "1.0.2",
    "manifest_version": 3,
    "permissions":[
            "storage"
        ],
    "action": {
        "default_popup": "pages/popup.html",
        "default_icon": {
            "16":"images/icon-16.png",
            "32": "images/icon-32.png",
            "48": "images/icon-48.png",
            "128": "images/icon-128.png"
        }
    },
    "options_ui": {
        "page": "pages/options.html",
        "open_in_tab":true
    },
    "content_scripts": [
        {
            "js": [
                "scripts/card.js",
                "scripts/content.js"
                
            ],
            "css":[
                "css/content.css"
            ],
            "matches": [
                "https://*/*"
            ]
            
        }
    ],
    "background":{
        "service_worker":"scripts/background.js",
        "type":"module"
    },
    "commands": {
        "_execute_action": {
            "suggested_key": {
                "default": "Ctrl+M",
                "mac": "Command+B"
            }
        }
    },
    "minimum_chrome_version":"102",
    "omnibox":{
        "keyword":"api"
    }

}